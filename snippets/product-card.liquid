<article class="panel product-card"><a href="{{ product.url }}"><div class="media-card">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 850px) 33vw, 100vw' }}{% endif %}</div><div class="product-card__content"><h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}</div></div></a></article>
