<section class="section">
  <div class="page-width">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="offerings-grid">
      {% for block in section.blocks %}<article class="panel offering" {{ block.shopify_attributes }}><span class="offering-number">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p>{% if block.settings.price != blank %}<div class="price">{{ block.settings.price }}</div>{% endif %}<a class="text-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label }} →</a></article>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Reading offerings","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Choose your path"},{"type":"text","id":"heading","label":"Heading","default":"Readings for the questions that matter"}],"blocks":[{"type":"offering","name":"Offering","settings":[{"type":"text","id":"title","label":"Title","default":"Clarity Reading"},{"type":"textarea","id":"copy","label":"Description","default":"A focused reading for one question or decision you need to see more clearly."},{"type":"text","id":"price","label":"Price text","default":"From ₹1,111"},{"type":"text","id":"label","label":"Link label","default":"Explore"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Reading offerings","blocks":[{"type":"offering"},{"type":"offering","settings":{"title":"Deep Dive","copy":"A layered session for patterns, relationships, and the next season of your life.","price":"From ₹2,222"}},{"type":"offering","settings":{"title":"Ritual Guidance","copy":"A personal ritual and card spread to help you integrate change with intention.","price":"From ₹3,333"}}]}]}
{% endschema %}
