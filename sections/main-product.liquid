<section class="section"><div class="page-width featured-product"><div class="featured-product__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 850px) 50vw, 100vw' }}{% endif %}</div><div><p class="eyebrow">{{ product.type }}</p><h1 class="section-title">{{ product.title }}</h1><div class="featured-product__price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="rte">{{ product.description }}</div>{% form 'product', product %}{% if product.has_only_default_variant == false %}<label for="Variant">Choose an option</label><select id="Variant" name="id" class="quantity" style="width:auto">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}</div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
