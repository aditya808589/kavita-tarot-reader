<section class="section"><div class="page-width"><h1 class="section-title">Search</h1><form action="{{ routes.search_url }}"><input class="quantity" style="width:min(500px,100%)" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search offerings"><button class="button">Search</button></form>{% if search.performed %}<div class="collection-grid" style="margin-top:40px">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="panel offering"><h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.content | strip_html | truncatewords: 24 }}</p></article>{% endif %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
