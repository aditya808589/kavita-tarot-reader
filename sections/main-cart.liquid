<section><div class="page-width"><header class="page-header"><h1 class="section-title">Your cart</h1></header>{% if cart.item_count > 0 %}{% form 'cart', cart %}<table class="cart-table"><thead><tr><th>Offering</th><th>Price</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{{ item.product.title }}</a><br><a class="text-link" href="{{ item.url_to_remove }}">Remove</a></td><td>{{ item.final_price | money }}</td><td><input class="quantity" name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title }}"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><div class="cart-summary"><strong>{{ cart.total_price | money }}</strong><button class="button button--ghost" type="submit" name="update">Update</button><button class="button" type="submit" name="checkout">Checkout</button></div>{% endform %}{% else %}<div class="panel empty-state"><p>Your cart is waiting for something meaningful.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore offerings</a></div>{% endif %}</div></section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
