<section id="tarot-pull" class="section">
  <div class="page-width">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="section-title">{{ section.settings.heading }}</h2><p class="section-copy">{{ section.settings.copy }}</p>
    <div class="cards-grid" style="margin-top:40px">
      {% for block in section.blocks %}
        <div class="tarot-card" data-tarot-card role="button" tabindex="0" aria-label="Reveal {{ block.settings.title }}" {{ block.shopify_attributes }}><div class="tarot-card__inner"><div class="tarot-card__face tarot-card__face--back"><span class="tarot-card__glyph">✦</span><span class="tarot-card__hint">Tap to reveal</span></div><div class="tarot-card__face tarot-card__face--front"><span class="tarot-card__glyph">{{ block.settings.symbol }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.message }}</p></div></div></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Three-card pull","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A moment for you"},{"type":"text","id":"heading","label":"Heading","default":"Choose what calls to you"},{"type":"textarea","id":"copy","label":"Text","default":"Pause, breathe, and turn over each card. Let the message meet you where you are."}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"text","id":"symbol","label":"Symbol","default":"☼"},{"type":"text","id":"title","label":"Title","default":"The Sun"},{"type":"textarea","id":"message","label":"Message","default":"Visibility, warmth, and a clear yes. Let yourself be seen."}]}],"presets":[{"name":"Three-card pull","blocks":[{"type":"card","settings":{"symbol":"☾","title":"The Moon","message":"Trust what is unfolding beneath the surface. Not every answer needs to arrive at once."}},{"type":"card","settings":{"symbol":"✦","title":"The Star","message":"Hope is returning. Choose the path that makes you feel more like yourself."}},{"type":"card","settings":{"symbol":"☼","title":"The Sun","message":"Visibility, warmth, and a clear yes. Let yourself be seen."}}]}]}
{% endschema %}
