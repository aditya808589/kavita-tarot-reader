<section class="k-section page-width k-story"><div class="k-story-media">{% if section.settings.portrait %}{{ section.settings.portrait | image_url: width: 1000 | image_tag: widths: '400,700,1000', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy' }}{% else %}<div class="k-portrait-empty" aria-hidden="true"><span>क</span></div>{% endif %}</div><div><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.copy }}</div>{% if section.settings.link %}<a class="k-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} ↗</a>{% endif %}</div></section>
{% schema %}
{"name":"Meet Kavita","settings":[{"type":"image_picker","id":"portrait","label":"Kavita's approved portrait"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A personal connection"},{"type":"text","id":"heading","label":"Heading","default":"Meet Kavita."},{"type":"richtext","id":"copy","label":"Story","default":"<p>I am Kavita, a tarot reader offering personalised one-to-one consultations to guide and empower you.</p><p>My approach begins with listening. Together, we explore your questions with warmth, empathy, and space for your own understanding.</p>"},{"type":"url","id":"link","label":"About page"},{"type":"text","id":"link_label","label":"Link label","default":"Read my story"}],"presets":[{"name":"Meet Kavita"}]}
{% endschema %}
