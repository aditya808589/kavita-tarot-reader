<section id="reading-faq" class="k-section page-width k-faq"><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2>{% for block in section.blocks %}{% if block.settings.answer != blank %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</section>
{% schema %}
{"name":"Kavita FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Before your reading"},{"type":"text","id":"heading","label":"Heading","default":"A little more clarity."}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Confirmed answer"}]}],"presets":[{"name":"Kavita FAQ"}]}
{% endschema %}
