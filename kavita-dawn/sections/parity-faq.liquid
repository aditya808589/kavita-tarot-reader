<style>
    .faq-category-nav {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin: 3rem 0 3.5rem;
    }

    .faq-cat-pill {
      background: #FFFFFF;
      border: 1px solid var(--v-border);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--v-text-muted);
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .faq-cat-pill.active, .faq-cat-pill:hover {
      background: var(--v-maroon);
      color: #FFFFFF;
      border-color: var(--v-maroon);
    }

    .faq-group-block {
      max-width: 900px;
      margin: 0 auto 3.5rem;
    }

    .faq-item {
      background: #FFFFFF;
      border: 1px solid var(--v-border);
      border-radius: 14px;
      margin-bottom: 1.2rem;
      overflow: hidden;
      box-shadow: var(--v-shadow-sm);
    }

    .faq-question {
      padding: 1.4rem 1.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-family: var(--font-heading);
      font-size: 1.05rem;
      color: var(--v-text-dark);
      font-weight: 700;
    }

    .faq-toggle-icon {
      color: var(--v-maroon);
      font-size: 1.4rem;
      font-weight: bold;
      transition: transform 0.3s ease;
    }

    .faq-item.active .faq-toggle-icon {
      transform: rotate(45deg);
    }

    .faq-answer {
      display: none;
      padding: 0 1.8rem 1.6rem;
      color: var(--v-text-body);
      font-size: 0.96rem;
      line-height: 1.7;
      border-top: 1px solid var(--v-border);
      padding-top: 1rem;
    }

    .faq-item.active .faq-answer {
      display: block;
    }
  </style>
