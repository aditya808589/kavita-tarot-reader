<script>
  (function() {
    function initKavitaHero(sectionContainer) {
      if (!sectionContainer) return;

      const enableParallax = sectionContainer.dataset.enableParallax === 'true';
      const enableFloating = sectionContainer.dataset.enableFloating === 'true';
      
      // Floating class toggle
      if (enableFloating) {
        sectionContainer.classList.add('kavita-hero--floating');
      }

      // Check reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion || !enableParallax || window.innerWidth < 992) {
        return;
      }

      const visualCol = sectionContainer.querySelector('.kavita-hero__visual-col');
      const cardsTrio = sectionContainer.querySelector('.kavita-hero__cards-trio');
      const orbitEl = sectionContainer.querySelector('.kavita-hero__celestial-orbit');

      if (!visualCol || !cardsTrio) return;

      let mouseX = 0;
      let mouseY = 0;
      let targetX = 0;
      let targetY = 0;
      let isHovering = false;
      let rAF = null;

      function onMouseMove(e) {
        const rect = visualCol.getBoundingClientRect();
        // Normalized coordinates from center (-1 to 1)
        const relX = (e.clientX - rect.left) / rect.width - 0.5;
        const relY = (e.clientY - rect.top) / rect.height - 0.5;

        // Subtle 14px maximum translation
        targetX = Math.max(-1, Math.min(1, relX)) * 14;
        targetY = Math.max(-1, Math.min(1, relY)) * 12;
      }

      function onMouseEnter() {
        isHovering = true;
        if (!rAF) updateParallax();
      }

      function onMouseLeave() {
        isHovering = false;
        targetX = 0;
        targetY = 0;
      }

      function updateParallax() {
        // Smooth linear interpolation (lerp factor 0.08)
        mouseX += (targetX - mouseX) * 0.08;
        mouseY += (targetY - mouseY) * 0.08;

        cardsTrio.style.transform = `translate3d(${mouseX.toFixed(2)}px, ${mouseY.toFixed(2)}px, 0)`;

        if (orbitEl) {
          orbitEl.style.transform = `translate(-50%, -50%) translate3d(${(-mouseX * 0.4).toFixed(2)}px, ${(-mouseY * 0.4).toFixed(2)}px, 0)`;
        }

        if (Math.abs(targetX - mouseX) > 0.05 || Math.abs(targetY - mouseY) > 0.05 || isHovering) {
          rAF = requestAnimationFrame(updateParallax);
        } else {
          rAF = null;
        }
      }

      visualCol.addEventListener('mousemove', onMouseMove, { passive: true });
      visualCol.addEventListener('mouseenter', onMouseEnter, { passive: true });
      visualCol.addEventListener('mouseleave', onMouseLeave, { passive: true });
    }

    // Initialize on DOM Ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initKavitaHero(document.getElementById('kavita-hero-{{ section.id }}'));
      });
    } else {
      initKavitaHero(document.getElementById('kavita-hero-{{ section.id }}'));
    }

    // Support Shopify Theme Editor dynamic section events
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initKavitaHero(document.getElementById('kavita-hero-{{ section.id }}'));
      }
    });
  })();
</script>

