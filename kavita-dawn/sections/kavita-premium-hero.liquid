{% comment %}
  KAVITA — Premium Luxury Tarot & Spirituals Hero Section
  File: sections/kavita-premium-hero.liquid
  Compatible with Shopify Online Store 2.0 (Dawn and all modern themes)
{% endcomment %}

{%- liquid
  assign section_id = section.id | replace: '-', '_'
  assign desktop_h = section.settings.desktop_height | default: '900px'
  assign overlay_opacity = section.settings.overlay_strength | divided_by: 100.0
-%}

<div
  id="kavita-hero-{{ section.id }}"
  class="kavita-hero kavita-hero--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-enable-parallax="{{ section.settings.enable_mouse_parallax }}"
  data-enable-floating="{{ section.settings.enable_floating_cards }}"
  data-enable-particles="{{ section.settings.enable_particles }}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Sacred Tarot, Modern Guidance' | escape }}"
>
  {% comment %} --- Background Media & Overlays --- {% endcomment %}
  <div class="kavita-hero__bg-wrap" aria-hidden="true">
    {%- if section.settings.hero_bg != blank -%}
      <picture>
        {%- if section.settings.mobile_hero_bg != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_hero_bg | image_url: width: 900 }}">
        {%- endif -%}
        {{ section.settings.hero_bg | image_url: width: 2400 | image_tag: 
          class: 'kavita-hero__bg-img', 
          loading: 'eager', 
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          alt: section.settings.heading | escape
        }}
      </picture>
    {%- else -%}
      {% comment %} Default reference luxury background fallback {% endcomment %}
      <img
        src="{{ 'kavita-hero-bg.jpg' | asset_url }}"
        alt="Kavita Tarot Mystical Sacred Altar"
        class="kavita-hero__bg-img"
        loading="eager"
        fetchpriority="high"
        width="2400"
        height="1350"
        onerror="this.style.display='none';"
      >
    {%- endif -%}

    {% comment %} Cinematic Dark Celestial Vignettes {% endcomment %}
    <div class="kavita-hero__overlay-editorial"></div>
    <div class="kavita-hero__overlay-radial"></div>
    <div class="kavita-hero__overlay-bottom"></div>
    <div class="kavita-hero__ambient-glow"></div>
  </div>

  {% comment %} --- Floating Golden Particles --- {% endcomment %}
  {%- if section.settings.enable_particles -%}
    <div class="kavita-hero__particles-container" aria-hidden="true" id="particles-{{ section.id }}">
      <span class="kavita-hero__particle p-1"></span>
      <span class="kavita-hero__particle p-2"></span>
      <span class="kavita-hero__particle p-3"></span>
      <span class="kavita-hero__particle p-4"></span>
      <span class="kavita-hero__particle p-5"></span>
      <span class="kavita-hero__particle p-6"></span>
      <span class="kavita-hero__particle p-7"></span>
      <span class="kavita-hero__particle p-8"></span>
      <span class="kavita-hero__particle p-9"></span>
      <span class="kavita-hero__particle p-10"></span>
      <span class="kavita-hero__particle p-11"></span>
      <span class="kavita-hero__particle p-12"></span>
      <span class="kavita-hero__particle p-13"></span>
      <span class="kavita-hero__particle p-14"></span>
    </div>
  {%- endif -%}

  {% comment %} --- Main Hero Stage --- {% endcomment %}
  <div class="kavita-hero__stage">
    <div class="kavita-hero__inner">

      {% comment %} LEFT COLUMN: Editorial Luxury Copy {% endcomment %}
      <div class="kavita-hero__content-col">
        
        {% comment %} Brand Logo (Shopify Image Picker Setting "logo") {% endcomment %}
        {%- if section.settings.show_logo or section.settings.logo != blank -%}
          <div class="kavita-hero__brand-logo-wrap">
            {%- if section.settings.logo != blank -%}
              {{ section.settings.logo | image_url: width: 500 | image_tag:
                class: 'kavita-hero__brand-logo',
                loading: 'eager',
                widths: '120, 180, 240, 320, 480',
                alt: shop.name | default: 'Kavita Tarot & Spirituals' | escape
              }}
            {%- else -%}
              <img
                src="{{ 'kavita-logo-gold.png' | asset_url }}"
                alt="Kavita Tarot & Spirituals"
                class="kavita-hero__brand-logo"
                loading="eager"
                width="{{ section.settings.logo_width | default: 140 }}"
                height="auto"
                onerror="this.style.display='none';"
              >
            {%- endif -%}
          </div>
        {%- endif -%}

        {% comment %} Eyebrow with Celestial Diamonds {% endcomment %}
        {%- if section.settings.eyebrow != blank -%}
          <div class="kavita-hero__eyebrow">
            <span class="kavita-hero__eyebrow-line"></span>
            <span class="kavita-hero__eyebrow-star">✦</span>
            <span class="kavita-hero__eyebrow-text">{{ section.settings.eyebrow }}</span>
            <span class="kavita-hero__eyebrow-star">✦</span>
            <span class="kavita-hero__eyebrow-line"></span>
          </div>
        {%- endif -%}

        {% comment %} Main Headline with Dual Gold & Ivory Styling {% endcomment %}
        <h1 class="kavita-hero__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | newline_to_br }}
          {%- else -%}
            <span class="kavita-hero__heading-gold">Sacred Tarot,</span><br>Modern Guidance
          {%- endif -%}
        </h1>

        {% comment %} Delicate Celestial Crescent Divider {% endcomment %}
        <div class="kavita-hero__crescent-divider" aria-hidden="true">
          <span class="kavita-hero__crescent-wing"></span>
          <svg class="kavita-hero__crescent-svg" width="28" height="22" viewBox="0 0 28 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 2C9.58 2 6 5.58 6 10C6 14.42 9.58 18 14 18C11.5 18 9.5 15.5 9.5 12C9.5 7.5 12 4 14 2Z" fill="url(#kavita-gold-grad-{{ section.id }})" />
            <circle cx="19" cy="8" r="1.5" fill="#FFDF78" />
            <circle cx="23" cy="14" r="1" fill="#D8B45D" />
            <defs>
              <linearGradient id="kavita-gold-grad-{{ section.id }}" x1="6" y1="2" x2="14" y2="18" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFDF78"/>
                <stop offset="0.5" stop-color="#D8B45D"/>
                <stop offset="1" stop-color="#C9A24B"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="kavita-hero__crescent-wing"></span>
        </div>

        {% comment %} Supporting Editorial Copy {% endcomment %}
        {%- if section.settings.description != blank -%}
          <p class="kavita-hero__desc">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        {% comment %} CTA Buttons (Shop Tarot + Explore Readings) {% endcomment %}
        <div class="kavita-hero__ctas">
          {%- if section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
              class="kavita-hero__btn kavita-hero__btn--primary"
            >
              <span>{{ section.settings.primary_button_label }}</span>
              <svg class="kavita-hero__btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8.66666 4L12.6667 8L8.66666 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '#services' }}"
              class="kavita-hero__btn kavita-hero__btn--secondary"
            >
              <span>{{ section.settings.secondary_button_label }}</span>
            </a>
          {%- endif -%}
        </div>

      </div>

      {% comment %} RIGHT COLUMN: Mystical Altar, Celestial Orbit & 3 Floating Tarot Cards {% endcomment %}
      <div class="kavita-hero__visual-col" id="cards-stage-{{ section.id }}">

        {% comment %} Rotating Celestial Orbit Rings & Moon Phases {% endcomment %}
        {%- if section.settings.enable_celestial_orbit -%}
          <div class="kavita-hero__celestial-orbit" aria-hidden="true">
            <div class="kavita-hero__orbit-ring kavita-hero__orbit-ring--outer"></div>
            <div class="kavita-hero__orbit-ring kavita-hero__orbit-ring--inner"></div>
            <div class="kavita-hero__orbit-sparkle s-1">✦</div>
            <div class="kavita-hero__orbit-sparkle s-2">✦</div>
            <div class="kavita-hero__orbit-sparkle s-3">✧</div>
            <div class="kavita-hero__orbit-sparkle s-4">✦</div>
            <div class="kavita-hero__orbit-moon m-1">☾</div>
            <div class="kavita-hero__orbit-moon m-2">○</div>
            <div class="kavita-hero__orbit-moon m-3">☽</div>
          </div>
        {%- endif -%}

        {% comment %} The 3 Floating Consecrated Tarot Cards {% endcomment %}
        <div class="kavita-hero__cards-trio" id="cards-trio-{{ section.id }}">

          {% comment %} CARD 1 (LEFT): The Empress (III) {% endcomment %}
          <div class="kavita-hero__card-anchor kavita-hero__card-anchor--left" data-tilt="-8">
            <div class="kavita-hero__card kavita-hero__card--1" tabindex="0" role="article" aria-label="{{ section.settings.card_1_label | default: 'The Empress Tarot Card' }}">
              {%- if section.settings.card_1_link != blank -%}<a href="{{ section.settings.card_1_link }}" class="kavita-hero__card-link" aria-label="{{ section.settings.card_1_label }}">{%- endif -%}
              <div class="kavita-hero__card-sheen"></div>
              <div class="kavita-hero__card-frame">
                <div class="kavita-hero__card-inner">
                  {%- if section.settings.card_1_image != blank -%}
                    {{ section.settings.card_1_image | image_url: width: 600 | image_tag: 
                      class: 'kavita-hero__card-img', 
                      loading: 'eager', 
                      alt: section.settings.card_1_label | default: 'The Empress'
                    }}
                  {%- else -%}
                    <img
                      src="{{ 'card-empress.jpg' | asset_url }}"
                      alt="The Empress (III) - Kavita Tarot"
                      class="kavita-hero__card-img"
                      loading="eager"
                      width="320"
                      height="540"
                      onerror="this.src='https://images.unsplash.com/photo-1611591475870-85f8c85775c9?auto=format&fit=crop&w=600&q=80';"
                    >
                  {%- endif -%}
                  <div class="kavita-hero__card-ribbon">
                    <span class="kavita-hero__card-num">III</span>
                    <span class="kavita-hero__card-title">{{ section.settings.card_1_label | default: 'THE EMPRESS' }}</span>
                  </div>
                </div>
              </div>
              {%- if section.settings.card_1_link != blank -%}</a>{%- endif -%}
            </div>
          </div>

          {% comment %} CARD 2 (CENTER): The Moon (XVIII) - Forward in depth {% endcomment %}
          <div class="kavita-hero__card-anchor kavita-hero__card-anchor--center" data-tilt="0">
            <div class="kavita-hero__card kavita-hero__card--2" tabindex="0" role="article" aria-label="{{ section.settings.card_2_label | default: 'The Moon Tarot Card' }}">
              {%- if section.settings.card_2_link != blank -%}<a href="{{ section.settings.card_2_link }}" class="kavita-hero__card-link" aria-label="{{ section.settings.card_2_label }}">{%- endif -%}
              <div class="kavita-hero__card-sheen"></div>
              <div class="kavita-hero__card-frame">
                <div class="kavita-hero__card-inner">
                  {%- if section.settings.card_2_image != blank -%}
                    {{ section.settings.card_2_image | image_url: width: 600 | image_tag: 
                      class: 'kavita-hero__card-img', 
                      loading: 'eager', 
                      alt: section.settings.card_2_label | default: 'The Moon'
                    }}
                  {%- else -%}
                    <img
                      src="{{ 'card-moon.jpg' | asset_url }}"
                      alt="The Moon (XVIII) - Kavita Tarot"
                      class="kavita-hero__card-img"
                      loading="eager"
                      width="340"
                      height="580"
                      onerror="this.src='https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=80';"
                    >
                  {%- endif -%}
                  <div class="kavita-hero__card-ribbon">
                    <span class="kavita-hero__card-num">XVIII</span>
                    <span class="kavita-hero__card-title">{{ section.settings.card_2_label | default: 'THE MOON' }}</span>
                  </div>
                </div>
              </div>
              {%- if section.settings.card_2_link != blank -%}</a>{%- endif -%}
            </div>
          </div>

          {% comment %} CARD 3 (RIGHT): The Star (XVII) {% endcomment %}
          <div class="kavita-hero__card-anchor kavita-hero__card-anchor--right" data-tilt="8">
            <div class="kavita-hero__card kavita-hero__card--3" tabindex="0" role="article" aria-label="{{ section.settings.card_3_label | default: 'The Star Tarot Card' }}">
              {%- if section.settings.card_3_link != blank -%}<a href="{{ section.settings.card_3_link }}" class="kavita-hero__card-link" aria-label="{{ section.settings.card_3_label }}">{%- endif -%}
              <div class="kavita-hero__card-sheen"></div>
              <div class="kavita-hero__card-frame">
                <div class="kavita-hero__card-inner">
                  {%- if section.settings.card_3_image != blank -%}
                    {{ section.settings.card_3_image | image_url: width: 600 | image_tag: 
                      class: 'kavita-hero__card-img', 
                      loading: 'eager', 
                      alt: section.settings.card_3_label | default: 'The Star'
                    }}
                  {%- else -%}
                    <img
                      src="{{ 'card-star.jpg' | asset_url }}"
                      alt="The Star (XVII) - Kavita Tarot"
                      class="kavita-hero__card-img"
                      loading="eager"
                      width="320"
                      height="540"
                      onerror="this.src='https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80';"
                    >
                  {%- endif -%}
                  <div class="kavita-hero__card-ribbon">
                    <span class="kavita-hero__card-num">XVII</span>
                    <span class="kavita-hero__card-title">{{ section.settings.card_3_label | default: 'THE STAR' }}</span>
                  </div>
                </div>
              </div>
              {%- if section.settings.card_3_link != blank -%}</a>{%- endif -%}
            </div>
          </div>

        </div>

        {% comment %} Crystal Orb Pedestal Illumination at Base of Cards {% endcomment %}
        <div class="kavita-hero__orb-glow" aria-hidden="true">
          <div class="kavita-hero__orb-sphere"></div>
          <div class="kavita-hero__orb-pedestal-light"></div>
        </div>

      </div>

    </div>
  </div>

  {% comment %} --- Bottom Luxury Trust / Feature Strip --- {% endcomment %}
  {%- if section.blocks.size > 0 -%}
    <div class="kavita-hero__trust-strip">
      <div class="kavita-hero__trust-container">
        <div class="kavita-hero__trust-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' -%}
              <div class="kavita-hero__trust-item" {{ block.shopify_attributes }}>
                <div class="kavita-hero__trust-icon-box" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'lotus' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2C12 2 8 8 8 13C8 16 10 18 12 18C14 18 16 16 16 13C16 8 12 2 12 2Z"/>
                        <path d="M4 14C4 14 6 17 9 18C7.5 19.5 5 19.5 3 19"/>
                        <path d="M20 14C20 14 18 17 15 18C16.5 19.5 19 19.5 21 19"/>
                      </svg>
                    {%- when 'shipping' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 2L11 13"/>
                        <path d="M22 2L15 22L11 13L2 9L22 2Z"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22S4 18 4 12V5L12 2L20 5V12C20 18 12 22 12 22Z"/>
                        <path d="M9 12L11 14L15 10"/>
                      </svg>
                    {%- when 'moon' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
                      </svg>
                    {%- else -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                  {%- endcase -%}
                </div>
                <div class="kavita-hero__trust-text">
                  <div class="kavita-hero__trust-title">{{ block.settings.title }}</div>
                  <div class="kavita-hero__trust-sub">{{ block.settings.subtitle }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% comment %} ==========================================================================
   SCOPED PRODUCTION CSS FOR KAVITA HERO
   ========================================================================== {% endcomment %}
<style>
  #kavita-hero-{{ section.id }} {
    --kh-bg: {{ section.settings.bg_base_color | default: '#07050C' }};
    --kh-deep-plum: #0B0614;
    --kh-purple-glow: rgba(43, 19, 74, 0.55);
    --kh-gold-accent: {{ section.settings.gold_accent_color | default: '#D8B45D' }};
    --kh-gold-light: #FFDF78;
    --kh-gold-dark: #A67D28;
    --kh-gold-glow: rgba(216, 180, 93, 0.35);
    --kh-heading-color: {{ section.settings.heading_color | default: '#F5EBDD' }};
    --kh-body-color: {{ section.settings.body_color | default: '#B9B0BF' }};
    --kh-serif: 'Cinzel', 'Cormorant Garamond', Georgia, serif;
    --kh-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    
    position: relative;
    width: 100%;
    min-height: {{ desktop_h }};
    background-color: var(--kh-bg);
    color: var(--kh-body-color);
    font-family: var(--kh-sans);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  #kavita-hero-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* --- Background Media & Overlays --- */
  .kavita-hero__bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .kavita-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
    transform: scale(1.02);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Editorial Dark Vignette: keeps left text 100% crisp & readable */
  .kavita-hero__overlay-editorial {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #07050C 0%,
      rgba(7, 5, 12, 0.98) 22%,
      rgba(11, 6, 20, 0.88) 42%,
      rgba(11, 6, 20, 0.45) 62%,
      rgba(11, 6, 20, 0.1) 85%,
      transparent 100%
    );
  }

  /* Top & Bottom Cinematic Edge Vignettes */
  .kavita-hero__overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(to top, #07050C 0%, rgba(7, 5, 12, 0.8) 40%, transparent 100%);
  }

  .kavita-hero__ambient-glow {
    position: absolute;
    top: 35%;
    right: 25%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, var(--kh-purple-glow) 0%, rgba(216, 180, 93, 0.12) 45%, transparent 70%);
    filter: blur(65px);
    pointer-events: none;
    opacity: 0.85;
  }

  /* --- Floating Particles --- */
  .kavita-hero__particles-container {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .kavita-hero__particle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF2CE 0%, var(--kh-gold-accent) 60%, transparent 100%);
    box-shadow: 0 0 8px var(--kh-gold-light);
    pointer-events: none;
    animation: khParticleDrift linear infinite;
  }

  .kavita-hero__particle.p-1  { width: 4px; height: 4px; top: 18%; left: 52%; animation-duration: 9s;  animation-delay: 0s; }
  .kavita-hero__particle.p-2  { width: 3px; height: 3px; top: 38%; left: 62%; animation-duration: 12s; animation-delay: 1.5s; }
  .kavita-hero__particle.p-3  { width: 5px; height: 5px; top: 55%; left: 48%; animation-duration: 8s;  animation-delay: 3s; }
  .kavita-hero__particle.p-4  { width: 3px; height: 3px; top: 25%; left: 78%; animation-duration: 14s; animation-delay: 0.5s; }
  .kavita-hero__particle.p-5  { width: 4px; height: 4px; top: 68%; left: 82%; animation-duration: 10s; animation-delay: 2s; }
  .kavita-hero__particle.p-6  { width: 2px; height: 2px; top: 45%; left: 38%; animation-duration: 13s; animation-delay: 4s; }
  .kavita-hero__particle.p-7  { width: 4px; height: 4px; top: 80%; left: 60%; animation-duration: 11s; animation-delay: 2.5s; }
  .kavita-hero__particle.p-8  { width: 3px; height: 3px; top: 12%; left: 30%; animation-duration: 15s; animation-delay: 5s; }
  .kavita-hero__particle.p-9  { width: 4px; height: 4px; top: 32%; left: 90%; animation-duration: 9s;  animation-delay: 1.2s; }
  .kavita-hero__particle.p-10 { width: 3px; height: 3px; top: 72%; left: 42%; animation-duration: 11s; animation-delay: 3.8s; }
  .kavita-hero__particle.p-11 { width: 5px; height: 5px; top: 48%; left: 70%; animation-duration: 8.5s;animation-delay: 0.8s; }
  .kavita-hero__particle.p-12 { width: 3px; height: 3px; top: 60%; left: 92%; animation-duration: 12s; animation-delay: 4.2s; }
  .kavita-hero__particle.p-13 { width: 4px; height: 4px; top: 22%; left: 44%; animation-duration: 10s; animation-delay: 2.2s; }
  .kavita-hero__particle.p-14 { width: 3px; height: 3px; top: 85%; left: 75%; animation-duration: 14s; animation-delay: 1.8s; }

  @keyframes khParticleDrift {
    0% {
      transform: translateY(0) translateX(0) scale(0.8);
      opacity: 0;
    }
