<section class="k-section page-width kr-offerings"><div class="kr-section-heading"><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p></div><div class="kr-product-grid">
{% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}
<article class="kr-product" {{ block.shopify_attributes }}><a class="kr-product-image" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '200,350,500,700', sizes: '(min-width: 750px) 30vw, 46vw' }}{% endif %}</a><div class="kr-product-content"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><div class="kr-price">{{ item.price | money }}{% if item.compare_at_price > item.price %}<s>{{ item.compare_at_price | money }}</s>{% endif %}</div>
{% if section.settings.is_service or item.variants.size > 1 %}<a class="kr-button" href="{{ item.url }}">View options</a>{% else %}{% form 'product', item, class: 'kr-add-form' %}<input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}"><button class="kr-button" type="submit" {% unless item.available %}disabled{% endunless %}>{% if item.available %}Add to bag{% else %}Sold out{% endif %}</button><p class="kr-form-error" role="status"></p>{% endform %}{% endif %}</div></article>
{% endif %}{% endfor %}</div></section>
{% schema %}
{"name":"Kavita product grid","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Curated for you"},{"type":"textarea","id":"copy","label":"Introduction"},{"type":"checkbox","id":"is_service","label":"Service booking links","default":false}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Kavita product grid"}]}
{% endschema %}