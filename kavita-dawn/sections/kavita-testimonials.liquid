<section class="k-section page-width">{% if section.blocks.size > 0 %}<p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="k-grid">{% for block in section.blocks %}{% if block.settings.quote != blank %}<figure class="k-service" {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption></figure>{% endif %}{% endfor %}</div>{% elsif request.design_mode %}<p>{{ 'kavita.real_reviews' | t }}</p>{% endif %}</section>
{% schema %}
{"name":"Kavita testimonials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Words shared with care"},{"type":"text","id":"heading","label":"Heading","default":"Reflections after a reading."}],"blocks":[{"type":"quote","name":"Verified testimonial","settings":[{"type":"textarea","id":"quote","label":"Client-approved quote"},{"type":"text","id":"author","label":"Approved attribution"}]}],"presets":[{"name":"Kavita testimonials"}]}
{% endschema %}
