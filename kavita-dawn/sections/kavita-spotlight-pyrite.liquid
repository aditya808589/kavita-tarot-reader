<section class="page-width" style="padding: 2.5rem 1.5rem;">
  <div style="background: linear-gradient(135deg, #FFFFFF 0%, #FDFBF7 100%); border: 2px solid var(--k-gold); border-radius: 24px; padding: 3rem 2.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; align-items: center; box-shadow: 0 15px 40px rgba(197, 155, 39, 0.15);">
    <div>
      <span style="display: inline-block; background: #80142B; color: #fff; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 4px; margin-bottom: 1rem;">
        {{ section.settings.badge | default: '★ #1 VASTU WEALTH BESTSELLER' }}
      </span>
      <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); color: #1C1917; margin-bottom: 1rem; line-height: 1.25;">
        {{ section.settings.heading | default: '7 Running Horses Natural Pyrite Wealth Frame' }}
      </h2>
      <p style="color: #5C544D; font-size: 1rem; line-height: 1.7; margin-bottom: 1.8rem;">
        {{ section.settings.copy | default: 'According to Vedic Vastu Shastra, placing 7 Galloping Horses in the North or East direction invites relentless financial momentum, executive promotions, and commercial prosperity. Handcrafted with genuine sparkling Pyrite stones.' }}
      </p>

      <ul style="list-style: none; margin-bottom: 2rem; padding: 0;">
        <li style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: #1C1917; margin-bottom: 0.5rem; font-weight: 500;"><span style="color: #80142B; font-weight: bold;">✓</span> 100% Natural Golden Pyrite Cluster Inlays</li>
        <li style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: #1C1917; margin-bottom: 0.5rem; font-weight: 500;"><span style="color: #80142B; font-weight: bold;">✓</span> Consecrated with Kuber & Lakshmi Veda Mantras</li>
        <li style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; color: #1C1917; margin-bottom: 0.5rem; font-weight: 500;"><span style="color: #80142B; font-weight: bold;">✓</span> Free Vedic Placement Chart for Living Room & Office</li>
      </ul>

      <div style="display: flex; align-items: baseline; gap: 1.2rem; margin-bottom: 2rem;">
        <span style="font-family: var(--font-heading); font-size: 2.2rem; color: #80142B; font-weight: 800;">₹{{ section.settings.price | default: '2,499' }}</span>
        <span style="text-decoration: line-through; color: #7D756D; font-size: 1.2rem;">₹{{ section.settings.compare_price | default: '4,999' }}</span>
        <span style="background: #E8F8F0; border: 1px solid #1B7A43; color: #1B7A43; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700;">SAVE 50%</span>
      </div>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="{{ section.settings.product_url | default: '/collections/all' }}" class="btn" style="background: #80142B; color: #FFFFFF; padding: 0.85rem 1.8rem; border-radius: 999px; font-family: var(--font-heading); font-weight: 700; text-decoration: none; box-shadow: 0 4px 18px rgba(115, 16, 36, 0.3);">
          ✦ Shop Pyrite Frame (Free Delivery)
        </a>
      </div>
    </div>

    <div style="border-radius: 18px; overflow: hidden; border: 1px solid #E8E2D5; box-shadow: 0 8px 25px rgba(0,0,0,0.08); max-height: 440px;">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'spotlight-img', style: 'width: 100%; height: 100%; object-fit: cover;' }}
      {% else %}
        <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80" alt="7 Horses Pyrite Frame" style="width: 100%; height: 100%; object-fit: cover; display: block;">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kavita Pyrite Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "★ #1 VASTU WEALTH BESTSELLER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "7 Running Horses Natural Pyrite Wealth Frame"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Description",
      "default": "According to Vedic Vastu Shastra, placing 7 Galloping Horses in the North or East direction invites relentless financial momentum, executive promotions, and commercial prosperity. Handcrafted with genuine sparkling Pyrite stones."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Sale Price",
      "default": "2,499"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "4,999"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Pyrite Image"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product or Collection Link"
    }
  ],
  "presets": [
    {
      "name": "Kavita Pyrite Spotlight"
    }
  ]
}
{% endschema %}

