<style>
    .story-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: center;
      padding: 4.5rem 0 5rem;
    }

    .story-portrait-box {
      border-radius: 24px;
      overflow: hidden;
      border: 2px solid var(--v-border-gold, #d4af37);
      box-shadow: 0 20px 50px rgba(125, 10, 40, 0.12);
      height: 540px;
      background: #F4EFE6;
      position: relative;
    }

    .story-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
    }

    .story-content h2 {
      font-size: clamp(2rem, 3.8vw, 2.8rem);
      color: var(--v-text-dark);
      margin-bottom: 1.2rem;
      line-height: 1.2;
    }

    .story-quote {
      font-size: 1.18rem;
      font-family: var(--font-heading);
      color: var(--v-maroon);
      font-weight: 700;
      line-height: 1.6;
      border-left: 3px solid var(--v-gold);
      padding-left: 1.2rem;
      margin: 1.8rem 0;
      font-style: italic;
    }

    .milestone-strip {
      background: #FFFFFF;
      border: 1px solid var(--v-border);
      border-radius: 20px;
      padding: 3rem 2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      text-align: center;
      margin: 3rem auto 5rem;
      box-shadow: var(--v-shadow-sm);
    }

    .milestone-num {
      font-family: var(--font-heading);
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--v-maroon);
      margin-bottom: 0.3rem;
    }

    .milestone-label {
      font-size: 0.88rem;
      color: var(--v-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .pillar-card {
      background: #FFFFFF;
      border: 1px solid var(--v-border);
      border-radius: 18px;
      padding: 2.2rem;
      box-shadow: var(--v-shadow-sm);
    }

    .pillar-icon {
      font-size: 2.2rem;
      color: var(--v-maroon);
      margin-bottom: 1rem;
    }

    @media (max-width: 900px) {
      .story-hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .story-portrait-box { height: 380px; }
    }
  </style>
