  <!-- Script: Catalog and Filtering -->
  
  
  <script>
    let activeProducts = [...STORE_PRODUCTS];

    function renderCollection(products) {
      const grid = document.getElementById('collectionGrid');
      const countEl = document.getElementById('displayResultsCount');
      
      countEl.innerText = `Showing ${products.length} sacred offerings`;

      if (products.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--v-text-muted);">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--v-maroon);">📿</div>
            <h3 style="color: var(--v-text-dark); margin-bottom: 0.5rem;">No products match these filters</h3>
            <p>Try resetting filters to explore our full energized catalogue.</p>
            <button class="btn btn-maroon" style="margin-top: 1.5rem;" onclick="resetFilters()">Reset All Filters</button>
          </div>
        `;
        return;
      }

      grid.innerHTML = products.map(p => `
        <div class="product-card">
          <div class="product-media">
            <span class="product-badge-flag">${p.badge}</span>
            <button type="button" class="product-wishlist-heart" aria-label="Add to Wishlist" onclick="toggleWishlist(this, ${p.id})">♡</button>
            <a href="/products/${p.handle}">
              <img loading="lazy" decoding="async" class="product-img" src="${p.img}" alt="${p.title}" width="600" height="600">
            </a>
          </div>
          <div class="product-info-wrap">
            <div>
              <div class="product-category-sub">${p.categoryLabel}</div>
              <h4 class="product-title">
                <a href="/products/${p.handle}">${p.title}</a>
              </h4>
              <div class="product-reviews-stars">
                ★★★★★ <span class="product-reviews-count">(${p.reviewsCount} reviews)</span>
              </div>
              <div class="product-pricing-row">
                <span class="current-price">₹${p.price.toLocaleString('en-IN')}</span>
                <span class="compare-price">₹${p.comparePrice.toLocaleString('en-IN')}</span>
                <span class="discount-pill">${p.discount}</span>
              </div>
            </div>
            <div class="product-card-actions">
              <button class="btn btn-maroon" onclick="addToCart('${p.title}', ${p.price}, '${p.img}', '${p.handle}')">
                ✦ Add to Cart
              </button>
              <a href="/products/${p.handle}" class="btn btn-outline">
                Details
              </a>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Toggle Mobile Filter Drawer
    function toggleMobileFilter() {
      const sidebar = document.getElementById('filterSidebar');
      const overlay = document.getElementById('filterOverlay');
      if (sidebar && overlay) {
        sidebar.classList.toggle('active');
        overlay.classList.toggle('active');
      }
    }

    // Toggle Wishlist Heart
    function toggleWishlist(btn, id) {
      btn.classList.toggle('is-active');
      const isActive = btn.classList.contains('is-active');
      btn.innerHTML = isActive ? '♥' : '♡';
      let count = parseInt(localStorage.getItem('kavita_wishlist_count') || '0', 10);
      count = isActive ? count + 1 : Math.max(0, count - 1);
      localStorage.setItem('kavita_wishlist_count', count);
      const badge = document.getElementById('mobileWishlistCount');
      if (badge) badge.innerText = count;
    }

    const packageHandles = [
      'no-contact-situation-5-card-reading',
      'future-spouse-reading',
      'love-marriage-pack-8-questions',
      'no-contact-situation-pack-4-questions',
      'heart-consultation-private-healing',
      'career-growth-reading',
      'reunion-reading',
      'deep-insight-reading-8-questions'
    ];

    function applyFilters() {
      const catAll = document.getElementById('cat_all') ? document.getElementById('cat_all').checked : false;
      const catPackages = document.getElementById('cat_packages') ? document.getElementById('cat_packages').checked : false;
      const catReadings = document.getElementById('cat_readings') ? document.getElementById('cat_readings').checked : false;
      const catBracelets = document.getElementById('cat_bracelets') ? document.getElementById('cat_bracelets').checked : false;
      const catCrystals = document.getElementById('cat_crystals') ? document.getElementById('cat_crystals').checked : false;

      const intDhanlabh = document.getElementById('int_dhanlabh').checked;
      const intProtection = document.getElementById('int_protection').checked;
      const intPeace = document.getElementById('int_peace').checked;
      const intCareer = document.getElementById('int_career').checked;
      const intShani = document.getElementById('int_shani').checked;

      activeProducts = STORE_PRODUCTS.filter(p => {
        let catMatch = true;
        if (!catAll) {
          let matchesAnyCat = false;
          let anyCatSelected = false;

          if (catPackages) {
            anyCatSelected = true;
            if (packageHandles.includes(p.handle)) matchesAnyCat = true;
          }
          if (catReadings) {
            anyCatSelected = true;
            if (p.category === 'readings' && !packageHandles.includes(p.handle)) matchesAnyCat = true;
          }
          if (catBracelets) {
            anyCatSelected = true;
            if (p.category === 'bracelets') matchesAnyCat = true;
          }
          if (catCrystals) {
            anyCatSelected = true;
            if (p.category === 'crystals') matchesAnyCat = true;
          }
          
          if (anyCatSelected) {
            catMatch = matchesAnyCat;
          }
        }

        let intMatch = true;
        const matchedInts = [];
        if (intDhanlabh) matchedInts.push('dhanlabh');
        if (intProtection) matchedInts.push('protection');
        if (intPeace) matchedInts.push('peace');
        if (intCareer) matchedInts.push('career');
        if (intShani) matchedInts.push('shani');
        if (matchedInts.length > 0) {
          intMatch = matchedInts.some(i => (p.intention || '').includes(i));
        }

        return catMatch && intMatch;
      });

      applySorting();
    }

    function applySorting() {
      const sortVal = document.getElementById('sortSelect').value;
      if (sortVal === 'price-low') {
        activeProducts.sort((a, b) => a.price - b.price);
      } else if (sortVal === 'price-high') {
        activeProducts.sort((a, b) => b.price - a.price);
      } else if (sortVal === 'rating') {
        activeProducts.sort((a, b) => b.rating - a.rating || b.reviewsCount - a.reviewsCount);
      } else {
        // Featured
        activeProducts.sort((a, b) => a.id - b.id);
      }
      renderCollection(activeProducts);
    }

    function resetFilters() {
      document.getElementById('cat_all').checked = true;
      if (document.getElementById('cat_packages')) document.getElementById('cat_packages').checked = false;
      document.getElementById('cat_readings').checked = false;
      document.getElementById('cat_bracelets').checked = false;
      document.getElementById('cat_crystals').checked = false;
      document.getElementById('int_dhanlabh').checked = false;
      document.getElementById('int_protection').checked = false;
      document.getElementById('int_peace').checked = false;
      document.getElementById('int_career').checked = false;
      document.getElementById('int_shani').checked = false;
      activeProducts = [...STORE_PRODUCTS];
      renderCollection(activeProducts);
    }

    // URL parameter parsing for category pre-filtering
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('cat');
      if (catParam && catParam !== 'all') {
        document.getElementById('cat_all').checked = false;
        if (catParam === 'packages' && document.getElementById('cat_packages')) {
          document.getElementById('cat_packages').checked = true;
        }
        if (catParam === 'readings') document.getElementById('cat_readings').checked = true;
        if (catParam === 'bracelets') document.getElementById('cat_bracelets').checked = true;
        if (catParam === 'crystals' || catParam === 'charms') document.getElementById('cat_crystals').checked = true;
        applyFilters();
      } else {
        renderCollection(STORE_PRODUCTS);
      }
      const wCount = localStorage.getItem('kavita_wishlist_count') || '0';
      const badge = document.getElementById('mobileWishlistCount');
      if (badge) badge.innerText = wCount;
    });
  </script>

