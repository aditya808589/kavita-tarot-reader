<style>
    .collections-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 3rem;
      padding: 3.5rem 0 5rem;
    }

    .filter-sidebar {
      background: #FFFFFF;
      border: 1px solid var(--v-border);
      border-radius: 18px;
      padding: 1.8rem;
      height: fit-content;
      position: sticky;
      top: 100px;
      box-shadow: var(--v-shadow-sm);
    }

    .filter-group {
      border-bottom: 1px solid var(--v-border);
      padding: 1.2rem 0;
    }
    .filter-group:first-child { padding-top: 0; }
    .filter-group:last-child { border-bottom: none; padding-bottom: 0; }

    .filter-title {
      font-size: 0.95rem;
      color: var(--v-text-dark);
      margin-bottom: 0.8rem;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .filter-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .filter-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.88rem;
      color: var(--v-text-body);
      cursor: pointer;
    }

    .filter-item input {
      accent-color: var(--v-maroon);
      cursor: pointer;
    }

    .filter-item:hover {
      color: var(--v-maroon);
    }

    .toolbar-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--v-border);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .results-count {
      font-size: 0.9rem;
      color: var(--v-text-muted);
      font-weight: 600;
    }

    .sort-select {
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--v-border);
      background: #FFFFFF;
      font-family: inherit;
      font-size: 0.85rem;
      color: var(--v-text-dark);
      cursor: pointer;
    }

    /* Mobile Filter Drawer */
    .mobile-filter-bar {
      display: none;
    }
    @media (max-width: 900px) {
      .mobile-filter-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        gap: 0.75rem;
      }
      .mobile-filter-btn {
        flex: 1;
        background: #FFFFFF;
        border: 1.5px solid #80142B;
        color: #80142B;
        font-family: 'Cinzel', serif;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.65rem 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(128, 20, 43, 0.08);
      }
      .filter-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 99990;
        backdrop-filter: blur(2px);
      }
      .filter-overlay.active {
        display: block;
      }
      .filter-sidebar {
        position: fixed !important;
        top: 0 !important;
        left: -320px !important;
        width: 300px !important;
        height: 100vh !important;
        background: #FFFFFF !important;
        z-index: 99995 !important;
        overflow-y: auto !important;
        padding: 1.5rem !important;
        box-shadow: 4px 0 24px rgba(0,0,0,0.2) !important;
        transition: left 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        margin-bottom: 0 !important;
      }
      .filter-sidebar.active {
        left: 0 !important;
      }
      .filter-close-btn {
        display: block !important;
      }
      .collections-layout {
        grid-template-columns: 1fr;
      }
      .products-grid {
        grid-template-columns: repeat(2, 1fr) !important; /* EXACTLY 2 IN ONE ROW ON MOBILE */
        gap: 0.75rem !important;
      }
    }
