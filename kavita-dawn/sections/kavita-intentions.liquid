<section class="k-section k-dark"><div class="page-width"><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="k-intentions">{% for block in section.blocks %}{% if block.settings.collection != blank %}<a href="{{ block.settings.collection.url }}" class="k-intention" {{ block.shopify_attributes }}><span>{{ block.settings.title | escape }}</span><span aria-hidden="true">↗</span></a>{% elsif request.design_mode %}<div class="k-intention" {{ block.shopify_attributes }}>{{ block.settings.title | escape }} <small>{{ 'kavita.select_collection' | t }}</small></div>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{"name":"Shop by intention","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Begin with a feeling"},{"type":"text","id":"heading","label":"Heading","default":"What are you inviting in?"}],"blocks":[{"type":"intention","name":"Intention","settings":[{"type":"text","id":"title","label":"Title","default":"Clarity"},{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Shop by intention"}]}
{% endschema %}
