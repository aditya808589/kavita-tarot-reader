<section class="page-width" style="padding-top: 2rem; padding-bottom: 2rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; background: var(--k-plum); border: 1px solid rgba(201, 162, 39, 0.25); border-radius: 14px; padding: 1.6rem 2rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span style="font-size: 1.8rem; color: var(--k-gold);">📜</span>
      <div>
        <h4 style="font-size: 1rem; color: #fff; margin: 0 0 0.2rem;">Lab-Certified Authentic</h4>
        <p style="font-size: 0.8rem; color: var(--k-muted); margin: 0;">100% genuine natural beads & crystals</p>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <span style="font-size: 1.8rem; color: var(--k-gold);">🕉</span>
      <div>
        <h4 style="font-size: 1rem; color: #fff; margin: 0 0 0.2rem;">Vedic Energized</h4>
        <p style="font-size: 0.8rem; color: var(--k-muted); margin: 0;">Pran Pratishtha consecrated by rituals</p>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <span style="font-size: 1.8rem; color: var(--k-gold);">📦</span>
      <div>
        <h4 style="font-size: 1rem; color: #fff; margin: 0 0 0.2rem;">Pan-India Delivery</h4>
        <p style="font-size: 0.8rem; color: var(--k-muted); margin: 0;">Free shipping on orders above ₹999</p>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <span style="font-size: 1.8rem; color: var(--k-gold);">💬</span>
      <div>
        <h4 style="font-size: 1rem; color: #fff; margin: 0 0 0.2rem;">Personal Guidance</h4>
        <p style="font-size: 0.8rem; color: var(--k-muted); margin: 0;">WhatsApp 1-on-1 reading support</p>
      </div>
    </div>
  </div>
</section>

