  <script>
    function renderCartPage() {
      const container = document.getElementById('cartPageList');
      const subtotalEl = document.getElementById('pageCartSubtotal');
      const totalEl = document.getElementById('pageCartTotal');

      const subtotal = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
      subtotalEl.innerText = '₹' + subtotal.toLocaleString('en-IN');
      totalEl.innerText = '₹' + subtotal.toLocaleString('en-IN');

      if (cart.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 4rem 1rem; color: var(--v-text-muted);">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--v-maroon);">📿</div>
            <h3 style="color: var(--v-text-dark); margin-bottom: 0.5rem;">Your Cart is Empty</h3>
            <p>You have not added any consecrated Rudrakshas or gemstones yet.</p>
            <a href="/collections/all" class="btn btn-maroon" style="margin-top: 1.5rem;">Browse Sacred Collections</a>
          </div>
        `;
        return;
      }

      container.innerHTML = cart.map((item, index) => `
        <div class="cart-page-item">
          <div class="cart-item-detail-wrap">
            <img class="cart-item-detail-img" src="${item.img}" alt="${item.name}" width="600" height="600">
            <div>
              <div style="font-weight: 700; color: var(--v-text-dark); margin-bottom: 0.2rem;">${item.name}</div>
              <button onclick="removeFromCart(${index}); renderCartPage();" style="background: none; border: none; color: #d32f2f; font-size: 0.78rem; cursor: pointer; font-weight: 600;">Remove</button>
            </div>
          </div>
          <div style="color: var(--v-text-muted); font-size: 0.95rem;">
            ₹${item.price.toLocaleString('en-IN')}
          </div>
          <div>
            <div class="cart-qty-ctrl">
              <button class="qty-btn" onclick="changeQty(${index}, -1); renderCartPage();">−</button>
              <span style="font-size: 0.9rem; font-weight: bold;">${item.qty}</span>
              <button class="qty-btn" onclick="changeQty(${index}, 1); renderCartPage();">+</button>
            </div>
          </div>
          <div style="text-align: right; font-family: var(--font-heading); font-weight: 800; color: var(--v-maroon); font-size: 1.05rem;">
            ₹${(item.price * item.qty).toLocaleString('en-IN')}
          </div>
        </div>
      `).join('');

      // Render "These Are Bought Together" on cart page
      function resolveCartAssetImg(imgPath, handle) {
        if (typeof window !== 'undefined' && window.KAVITA_LIVE_PRODUCTS && handle && window.KAVITA_LIVE_PRODUCTS[handle]) {
          const lp = window.KAVITA_LIVE_PRODUCTS[handle];
          if (lp.featured_image) return lp.featured_image;
          if (lp.images && lp.images.length > 0) return lp.images[0];
        }
        if (typeof STORE_PRODUCTS !== 'undefined' && handle) {
          const sp = STORE_PRODUCTS.find(p => p.handle === handle);
          if (sp && sp.img && (sp.img.startsWith('http') || sp.img.startsWith('//'))) return sp.img;
        }
        if (imgPath && (imgPath.startsWith('http://') || imgPath.startsWith('https://') || imgPath.startsWith('//'))) {
          return imgPath;
        }
        if (typeof window !== 'undefined' && window.KAVITA_ASSET_BASE && imgPath) {
          const filename = imgPath.split('/').pop();
          return window.KAVITA_ASSET_BASE + filename;
        }
        return imgPath;
      }

      const btContainer = document.getElementById('cartPageBoughtTogether');
      if (btContainer) {
        const upsellCandidates = [
          { handle: 'meditation-crystal-tumbles', name: 'Meditation Crystal Tumbles (Set of 7)', price: 599, compare: 999, img: '{{ 'product-meditation-tumbles.jpg' | asset_url }}' },
          { handle: 'pyrite-golden-energy-booster', name: 'Natural Golden Pyrite Wealth Cluster', price: 899, compare: 1499, img: '{{ 'product-pyrite-booster.png' | asset_url }}' },
          { handle: 'pyrite-money-success-bracelet', name: 'Pyrite Money Magnet Healing Bracelet', price: 799, compare: 1299, img: '{{ 'product-pyrite-money-bracelet.jpg' | asset_url }}' },
          { handle: 'seven-chakra-bracelet', name: '7 Chakra Healing & Harmony Bracelet', price: 699, compare: 1199, img: '{{ 'product-seven-chakra-bracelet.png' | asset_url }}' },
          { handle: 'rose-quartz-raw', name: 'Raw Rose Quartz Unconditional Love Stone', price: 799, compare: 1199, img: '{{ 'product-rose-quartz-love.png' | asset_url }}' }
        ];

        const cartHandles = cart.map(i => (i.handle || i.name || i.title || '').toLowerCase());
        const eligibleUpsells = upsellCandidates.filter(u => !cartHandles.some(ch => ch.includes(u.handle.toLowerCase()) || ch.includes(u.name.toLowerCase()))).slice(0, 3);

        if (eligibleUpsells.length > 0) {
          btContainer.innerHTML = `
            <div style="margin-top: 2.5rem; background: #FFFDF9; border: 1.5px dashed #D4AF37; border-radius: 14px; padding: 1.4rem;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid #EEDFCA; padding-bottom: 0.6rem;">
                <div>
                  <span style="font-size: 0.72rem; font-weight: 700; color: #80142B; text-transform: uppercase; letter-spacing: 0.1em; display: block;">✦ Spiritual Pairings</span>
                  <h4 style="font-family: 'Cinzel', serif; font-size: 1.15rem; color: #2A1D1A; margin: 2px 0 0;">These Are Frequently Bought Together</h4>
                </div>
                <span style="background: #FFF3D6; color: #80142B; font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 50px;">Special Add-on Price</span>
              </div>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                ${eligibleUpsells.map(u => {
                  const uImg = resolveCartAssetImg(u.img, u.handle);
                  return `
                  <div style="background: #FFF; border: 1px solid #E5DCCE; border-radius: 10px; padding: 0.85rem; display: flex; align-items: center; gap: 0.85rem;">
                    <img src="${uImg}" alt="${u.name}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; flex-shrink: 0; border: 1px solid #EFE6D8;" onerror="this.onerror=null; this.src=(window.KAVITA_ASSET_BASE ? window.KAVITA_ASSET_BASE + 'kavita-logo-gold.png' : '{{ 'kavita-logo-gold.png' | asset_url }}');" width="600" height="600">
                    <div style="flex: 1; min-width: 0;">
                      <div style="font-size: 0.82rem; font-weight: 700; color: #2A1D1A; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${u.name}</div>
                      <div style="font-size: 0.85rem; font-weight: 800; color: #80142B; margin-top: 2px;">₹${u.price.toLocaleString('en-IN')} <span style="font-size: 0.72rem; color: #888; text-decoration: line-through; font-weight: 400;">₹${u.compare.toLocaleString('en-IN')}</span></div>
                      <button type="button" onclick="addToCart('${u.name}', ${u.price}, '${uImg}', '${u.handle}'); renderCartPage();" class="btn btn-maroon" style="padding: 0.3rem 0.75rem; font-size: 0.75rem; border-radius: 6px; margin-top: 5px; cursor: pointer; border: none;">
                        + Add to Bag
                      </button>
                    </div>
                  </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        } else {
          btContainer.innerHTML = '';
        }
      }
    }

    function clearFullCart() {
      if (confirm('Are you sure you want to clear your cart?')) {
        cart = [];
        saveCart();
        updateCartUI();
        renderCartPage();
      }
    }

    window.addEventListener('DOMContentLoaded', renderCartPage);
  </script>
