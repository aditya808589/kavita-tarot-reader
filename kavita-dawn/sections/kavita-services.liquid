<section class="k-section page-width"><div class="k-heading"><div><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><p>{{ section.settings.copy | escape }}</p></div><div class="k-grid">{% for block in section.blocks %}{% assign service = block.settings.product %}{% if service != blank %}<article class="k-service" {{ block.shopify_attributes }}><span class="k-index">0{{ forloop.index }}</span><h3>{{ service.title | escape }}</h3><p>{{ block.settings.summary | escape }}</p><div class="k-service-bottom">{% render 'price', product: service %}<a class="k-link" href="{{ service.url }}">{{ 'kavita.explore' | t }} ↗</a></div></article>{% elsif request.design_mode %}<div class="k-service" {{ block.shopify_attributes }}><h3>{{ block.settings.label | escape }}</h3><p>{{ 'kavita.configure_service' | t }}</p></div>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name":"Kavita services","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A reading that meets you here"},{"type":"text","id":"heading","label":"Heading","default":"Space for your questions."},{"type":"textarea","id":"copy","label":"Introduction","default":"Explore personal readings and healing sessions. Choose the service that feels right for you."}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"label","label":"Editor label","default":"Select a service"},{"type":"product","id":"product","label":"Service product"},{"type":"textarea","id":"summary","label":"Approved service description"}]}],"presets":[{"name":"Kavita services"}]}
{% endschema %}
