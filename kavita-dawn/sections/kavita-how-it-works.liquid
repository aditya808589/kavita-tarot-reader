<section class="k-section page-width"><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><ol class="k-grid k-steps">{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span class="k-index">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p></li>{% endfor %}</ol></section>
{% schema %}{"name":"How readings work","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Simple. Personal. Thoughtful."},{"type":"text","id":"heading","label":"Heading","default":"Your moment of clarity."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"copy","label":"Description"}]}],"presets":[{"name":"How readings work"}]}{% endschema %}
