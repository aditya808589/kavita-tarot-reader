<section class="k-section page-width k-tool" data-kavita-deck data-instruction="{{ section.settings.copy | escape }}"><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p><div class="k-cards">{% for i in (1..3) %}<button class="k-card" type="button" data-pull aria-label="{{ 'kavita.reveal' | t: number: i }}" aria-pressed="false">✦</button>{% endfor %}</div><div class="k-reading" aria-live="polite"><h3 data-card-title></h3><p data-card-copy>{{ section.settings.copy | escape }}</p></div><button class="button button--secondary" type="button" data-reset>{{ 'kavita.shuffle' | t }}</button><script type="application/json" data-card-data>[{% for block in section.blocks %}{"title":{{ block.settings.title | json }},"reflection":{{ block.settings.reflection | json }},"symbol":{{ block.settings.symbol | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script></section>
{% schema %}{"name":"Reflective card pull","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A moment to yourself"},{"type":"text","id":"heading","label":"Heading","default":"Pause. Breathe. Choose a card."},{"type":"textarea","id":"copy","label":"Instructions","default":"Bring a question to mind. Choose a card for a reflection prompt, not a prediction."}],"blocks":[{"type":"card","name":"Reflection card","settings":[{"type":"text","id":"title","label":"Card title"},{"type":"textarea","id":"reflection","label":"Reflection question"},{"type":"text","id":"symbol","label":"Symbol","default":"✦"}]}],"presets":[{"name":"Reflective card pull"}]}{% endschema %}
