{% comment %}
  KAVITA — Rajvira-Style 2-Tier Header & Category Navigation Bar
  File: sections/kavita-rajvira-header.liquid
  Compatible with Shopify Online Store 2.0
{% endcomment %}

<div id="kavita-rajvira-header-{{ section.id }}" class="kavita-hdr">
  {% comment %} --- Tier 0: Royal Temple Maroon Announcement Bar --- {% endcomment %}
  {%- if section.settings.show_announcement -%}
    <div class="kavita-hdr__announcement">
      <div class="kavita-hdr__announcement-track">
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> CELEBRATING SACRED MOMENTS</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> A LEGACY OF SACRED TAROT & SPIRITUAL GUIDANCE</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> LIMITED READING SLOTS AVAILABLE — BOOK ONLINE</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> FREE WORLDWIDE SHIPPING ON SACRED TOOLS OVER ₹999</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> 100% ENERGIZED & SPIRITUALLY CLEANSED</div>
        {% comment %} Duplicate for infinite marquee scroll {% endcomment %}
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> CELEBRATING SACRED MOMENTS</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> A LEGACY OF SACRED TAROT & SPIRITUAL GUIDANCE</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> LIMITED READING SLOTS AVAILABLE — BOOK ONLINE</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> FREE WORLDWIDE SHIPPING ON SACRED TOOLS OVER ₹999</div>
        <div class="kavita-hdr__announcement-item"><span class="bullet">✦</span> 100% ENERGIZED & SPIRITUALLY CLEANSED</div>
      </div>
    </div>
  {%- endif -%}

  {% comment %} --- Tier 1: Main Header (Logo, Wide Center Search Bar, Icons) --- {% endcomment %}
  <div class="kavita-hdr__main">
    <div class="kavita-hdr__container">
      {% comment %} Left: Brand Logo {% endcomment %}
      <div class="kavita-hdr__brand">
        <a href="{{ routes.root_url }}" class="kavita-hdr__logo-link">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 320 | image_tag:
              class: 'kavita-hdr__logo-img',
              loading: 'eager',
              alt: shop.name | escape
            }}
          {%- else -%}
            <img
              src="{{ 'kavita-logo-gold.png' | asset_url }}"
              alt="Kavita Tarot & Spirituals"
              class="kavita-hdr__logo-img"
              loading="eager"
              width="150"
              height="48"
              onerror="this.style.display='none';"
            >
          {%- endif -%}
          <span class="kavita-hdr__brand-name">KAVITA TAROT READER</span>
        </a>
      </div>

      {% comment %} Center: Wide Search Input Pill {% endcomment %}
      <div class="kavita-hdr__search-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search" class="kavita-hdr__search-form">
          <svg class="kavita-hdr__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            class="kavita-hdr__search-input"
            placeholder="Search for tarot decks, crystals, readings & +1000 designs..."
            aria-label="Search store"
            autocomplete="off"
          >
          <button type="submit" class="kavita-hdr__search-btn" aria-label="Submit search">
            Search
          </button>
        </form>
      </div>

      {% comment %} Right: Utilities & Icons {% endcomment %}
      <div class="kavita-hdr__actions">
        <!-- Mobile Search Trigger Button -->
        <button type="button" class="kavita-hdr__icon-btn kavita-hdr__icon-btn--search-mobile" onclick="if(typeof openSearchModal==='function'){openSearchModal();}else{window.location.href='/search';}" aria-label="Search Catalog" style="background: none; border: none; cursor: pointer;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <a href="/products/live-audio-call-tarot-reading" class="kavita-hdr__util-link">
          <span class="kavita-hdr__util-dot">●</span> Book Online
        </a>

        {% comment %} Wishlist {% endcomment %}
        <a href="/collections/all?wishlist=1" class="kavita-hdr__icon-btn" aria-label="Wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="kavita-hdr__badge" id="kavita-wishlist-badge">0</span>
        </a>

        {% comment %} Cart {% endcomment %}
        <a href="{{ routes.cart_url }}" class="kavita-hdr__icon-btn kavita-hdr__icon-btn--cart" id="openCartBtn" data-open-cart aria-label="Cart">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="kavita-hdr__badge kavita-hdr__badge--cart" id="cartCount">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  {% comment %} --- Tier 2: Dedicated Horizontal Category Navigation Menu Bar --- {% endcomment %}
  <nav id="kr-navigation" class="kavita-hdr__nav-bar" aria-label="Category Navigation">
    <div class="kavita-hdr__container">
      <ul class="kavita-hdr__menu">
        <li class="kavita-hdr__menu-item">
          <a href="/collections/all" class="kavita-hdr__menu-link">All Collections</a>
        </li>
        <li class="kavita-hdr__menu-item">
          <a href="/?view=consultations" class="kavita-hdr__menu-link">Tarot Readings</a>
        </li>
        <li class="kavita-hdr__menu-item kavita-hdr__menu-item--dropdown">
          <a href="/?view=packages" class="kavita-hdr__menu-link">
            Signature Packages
            <svg class="kavita-hdr__caret" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </a>
          <div class="kavita-hdr__dropdown">
            <div class="kavita-hdr__dropdown-grid" style="grid-template-columns: repeat(2, 1fr); min-width: 520px; gap: 1.5rem;">
              <div class="kavita-hdr__dropdown-col">
                <span class="kavita-hdr__dropdown-title">✦ Love &amp; Relationships</span>
                <a href="/products/no-contact-situation-5-card-reading">No Contact Situation (5 Card)</a>
                <a href="/products/future-spouse-reading">Future Spouse &amp; Destined Connection</a>
                <a href="/products/love-marriage-pack-8-questions">Love &amp; Marriage Pack (8 Questions)</a>
                <a href="/products/no-contact-situation-pack-4-questions">No Contact Situation (4 Questions)</a>
                <a href="/products/reunion-reading">Reunion Reading: Will They Return?</a>
              </div>
              <div class="kavita-hdr__dropdown-col">
                <span class="kavita-hdr__dropdown-title">✦ Healing &amp; Career Growth</span>
                <a href="/products/heart-consultation-private-healing">Heart Consultation: 1:1 Healing</a>
                <a href="/products/career-growth-reading">Career Growth &amp; Financial Path</a>
                <a href="/products/deep-insight-reading-8-questions">Deep Insight Reading (8 Questions)</a>
                <div style="margin-top: 0.85rem; padding-top: 0.65rem; border-top: 1px dashed #ECE7DE;">
                  <a href="/?view=packages" style="color: #80142B; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                    ✦ View Dedicated Packages Portal →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li class="kavita-hdr__menu-item">
          <a href="/collections/all?cat=bracelets" class="kavita-hdr__menu-link">Healing Bracelets</a>
        </li>
        <li class="kavita-hdr__menu-item">
          <a href="/collections/all?cat=crystals" class="kavita-hdr__menu-link">Crystals &amp; Carvings</a>
        </li>
        <li class="kavita-hdr__menu-item">
          <a href="/?view=about" class="kavita-hdr__menu-link">About Kavita</a>
        </li>
        <li class="kavita-hdr__menu-item">
          <a href="/pages/contact" class="kavita-hdr__menu-link">Contact</a>
        </li>
      </ul>
    </div>
  </nav>
</div>



{% schema %}
{
  "name": "Kavita Rajvira Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show top announcement bar",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand logo image"
    }
  ]
}
{% endschema %}

