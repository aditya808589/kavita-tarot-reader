<section class="k-hero"><div class="page-width k-hero-grid"><div><p class="k-kicker">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="k-intro">{{ section.settings.copy | escape }}</p><div class="k-actions">{% if section.settings.booking_page != blank %}<a class="button" href="{{ section.settings.booking_page.url }}">{{ 'kavita.book' | t }}</a>{% endif %}<a class="k-link" href="{{ routes.all_products_collection_url }}">{{ 'kavita.shop' | t }} ↗</a></div><p class="k-small">{{ section.settings.note | escape }}</p></div><div class="k-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500,750,1100,1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'k-hero-photo' }}{% else %}<div class="k-arch" aria-hidden="true"><span class="k-orbit"></span><span class="k-moon">☾</span><span class="k-art-caption">K A V I T A</span></div>{% endif %}</div></div></section>
{% schema %}
{"name":"Kavita hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Tarot readings · Mindful rituals · Crystals"},{"type":"text","id":"heading","label":"Heading","default":"You Are The Secret. Let Tarot Explore You."},{"type":"textarea","id":"copy","label":"Introduction","default":"A quiet moment. A different perspective. Explore your questions with personal tarot readings and thoughtfully chosen spiritual tools."},{"type":"text","id":"note","label":"Small note","default":"For reflection, clarity, and your next step."},{"type":"page","id":"booking_page","label":"Booking page"},{"type":"image_picker","id":"image","label":"Approved hero photograph"}],"presets":[{"name":"Kavita hero"}]}
{% endschema %}
